# Onec Platform Help MCP Server configuration

# Версия платформы по умолчанию (должна совпадать с проиндексированной / скопированной коллекцией)
DEFAULT_PLATFORM_VERSION=8.3.26

# Путь к папке со справкой внутри контейнера
HELP_BASE_PATH=/app/data/help1c

# --- При запуске через docker compose (сервер в контейнере) ---
# По именам контейнеров (надёжный DNS)
EMBEDDING_SERVICE_URL=http://onec-help-embedding:8004
QDRANT_URL=http://onec-help-qdrant:6333

# --- Если MCP-сервер запущен на хосте (не в Docker) — раскомментируйте и укажите: ---
# EMBEDDING_SERVICE_URL=http://localhost:8014
# QDRANT_URL=http://localhost:6347

# Настройки сервера (в compose по умолчанию порт 9063, маппинг 9063:9063)
SERVER_HOST=0.0.0.0
SERVER_PORT=9063
LOG_LEVEL=INFO
